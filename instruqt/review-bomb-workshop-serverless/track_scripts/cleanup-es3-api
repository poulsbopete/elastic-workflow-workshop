#!/bin/bash
# Deletes the Serverless project created during track setup (same pattern as
# elastic-autonomous-observability track_scripts/cleanup-es3-api).
set -e
echo "Cleaning up the Elasticsearch Serverless project"

echo "Project type: ${PROJECT_TYPE:-}"
echo "Regions: ${REGIONS:-}"

export DEPLOYMENT_ID
DEPLOYMENT_ID=$(agent variable get ES_DEPLOYMENT_ID 2>/dev/null || echo "")
echo "Deployment ID: ${DEPLOYMENT_ID:-<not set>}"

if [ -z "${DEPLOYMENT_ID:-}" ] || [ "$DEPLOYMENT_ID" = "" ]; then
    echo "WARNING: ES_DEPLOYMENT_ID not found in agent variables"
    echo "Skipping cleanup - project may not have been created or already cleaned up"
    exit 0
fi

if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    PME_CLOUD_INSTRUQT_API_KEY="${ESS_CLOUD_API_KEY:-}"
fi
if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    PME_CLOUD_INSTRUQT_API_KEY=$(agent variable get ESS_CLOUD_API_KEY 2>/dev/null || echo "")
fi
if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    echo "WARNING: PME_CLOUD_INSTRUQT_API_KEY / ESS_CLOUD_API_KEY not set"
    echo "Cannot delete project without API key"
    exit 0
fi
export PME_CLOUD_INSTRUQT_API_KEY

python3 bin/es3-api.py \
   --operation delete \
   --project-type "${PROJECT_TYPE}" \
   --regions "${REGIONS}" \
   --project-id "$DEPLOYMENT_ID" \
   --api-key "${PME_CLOUD_INSTRUQT_API_KEY}"

echo "Done"
