#!/bin/bash
#
# Track setup for Review Bomb Workshop (Serverless Elasticsearch).
# Based on elastic-autonomous-observability track_scripts/setup-es3-api:
#   - elastic/es3-api-v2 image + ESS_CLOUD_API_KEY
#   - python3 bin/es3-api.py create/delete
#   - nginx proxies Kibana :8080 and Elasticsearch :9200 to the Cloud project
#
# After provisioning, clones this workshop and runs instruqt/startup-serverless.sh
# (bulk index data + FastAPI on :8000).
#

# ── Elastic Cloud API key (same resolution as AO track) ─────────────────────
echo "=== Checking for Elastic Cloud API key ==="
if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    PME_CLOUD_INSTRUQT_API_KEY="${ESS_CLOUD_API_KEY:-}"
fi
if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    PME_CLOUD_INSTRUQT_API_KEY=$(agent variable get PME_CLOUD_INSTRUQT_API_KEY 2>/dev/null || echo "")
fi
if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    ESS_KEY=$(agent variable get ESS_CLOUD_API_KEY 2>/dev/null || echo "")
    if [ -n "$ESS_KEY" ]; then
        PME_CLOUD_INSTRUQT_API_KEY="$ESS_KEY"
    fi
fi

if [ -z "${PME_CLOUD_INSTRUQT_API_KEY:-}" ]; then
    echo "ERROR: Elastic Cloud API key is not set."
    echo "Configure secret ESS_CLOUD_API_KEY for this track (Sandbox → Secrets),"
    echo "same as elastic-autonomous-observability."
    exit 1
fi
export PME_CLOUD_INSTRUQT_API_KEY

set -euxo pipefail

echo "Running track setup on host es3-api (Serverless Elasticsearch workshop)"

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    sleep 1
done

PROJECT_TYPE="${PROJECT_TYPE:-elasticsearch}"
REGIONS="${REGIONS:-aws-us-east-1}"
OPTIMIZED_FOR="${OPTIMIZED_FOR:-general_purpose}"

echo "Project type: ${PROJECT_TYPE}"
echo "Regions: ${REGIONS}"
echo "Optimized for: ${OPTIMIZED_FOR}"

if [ "$PROJECT_TYPE" != "elasticsearch" ]; then
    echo "ERROR: This workshop requires PROJECT_TYPE=elasticsearch in config.yml"
    exit 1
fi

python3 bin/es3-api.py \
    --operation create \
    --project-type "$PROJECT_TYPE" \
    --optimized-for "$OPTIMIZED_FOR" \
    --regions "$REGIONS" \
    --project-name "${INSTRUQT_TRACK_SLUG}-${INSTRUQT_PARTICIPANT_ID}-$(date '+%s')" \
    --api-key "${PME_CLOUD_INSTRUQT_API_KEY}" \
    --wait-for-ready

timeout=30
counter=0
while [ $counter -lt $timeout ]; do
    if [ -f "/tmp/project_results.json" ]; then
        echo "project_results.json ready"
        break
    fi
    echo "Waiting for /tmp/project_results.json... ($((counter + 1))/${timeout}s)"
    sleep 1
    counter=$((counter + 1))
done

if [ ! -f "/tmp/project_results.json" ]; then
    echo "ERROR: /tmp/project_results.json not found"
    exit 1
fi

export KIBANA_URL
export ES_URL
export ELASTICSEARCH_PASSWORD
export ES_USERNAME
KIBANA_URL=$(jq -r --arg region "$REGIONS" '.[$region].endpoints.kibana' /tmp/project_results.json)
ES_URL=$(jq -r --arg region "$REGIONS" '.[$region].endpoints.elasticsearch' /tmp/project_results.json)
ELASTICSEARCH_PASSWORD=$(jq -r --arg region "$REGIONS" '.[$region].credentials.password' /tmp/project_results.json)
ES_USERNAME=$(jq -r --arg region "$REGIONS" '.[$region].credentials.username' /tmp/project_results.json)

agent variable set ES_KIBANA_URL "$KIBANA_URL"
agent variable set ES_URL "$ES_URL"
agent variable set ES_USERNAME "$ES_USERNAME"
agent variable set ES_PASSWORD "$ELASTICSEARCH_PASSWORD"
agent variable set ES_DEPLOYMENT_ID "$(jq -r --arg region "$REGIONS" '.[$region].id' /tmp/project_results.json)"

echo "Generating Elasticsearch API key..."
output=$(curl -X POST -s -u "${ES_USERNAME}:${ELASTICSEARCH_PASSWORD}" \
  -w "\n%{http_code}" \
  "$ES_URL/_security/api_key" \
  -H 'Content-Type: application/json' \
  -d '{"name": "workshop-instruqt"}')

http_code=$(echo "$output" | tail -n1)
response_body=$(echo "$output" | sed '$d')

if [ "$http_code" != "200" ]; then
  echo "WARNING: API key creation HTTP ${http_code}: ${response_body}"
fi

ELASTICSEARCH_API_KEY=$(echo "$response_body" | jq -r '.encoded // empty')
if [ -z "$ELASTICSEARCH_API_KEY" ]; then
  echo "ERROR: Could not create Elasticsearch API key"
  exit 1
fi

agent variable set ES_API_KEY "$ELASTICSEARCH_API_KEY"
agent variable set ELASTIC_API_KEY "$ELASTICSEARCH_API_KEY"

jq --arg region "$REGIONS" --arg apikey "$ELASTICSEARCH_API_KEY" \
  '.[$region] = (.[$region] // {}) |
   .[$region].credentials = (.[$region].credentials // {}) |
   .[$region].credentials.api_key = $apikey' \
  /tmp/project_results.json > /tmp/project_results.json.tmp
mv /tmp/project_results.json.tmp /tmp/project_results.json

BASE64=$(echo -n "${ES_USERNAME}:${ELASTICSEARCH_PASSWORD}" | base64)
KIBANA_URL_WITHOUT_PROTOCOL=$(echo "$KIBANA_URL" | sed -e 's#http[s]\?://##g')

echo "Configuring nginx (Kibana :8080, Elasticsearch :9200 → Cloud)"
cat > /etc/nginx/conf.d/default.conf <<NGINX_EOF
server {
  listen 8080 default_server;
  server_name kibana;
  location /nginx_status {
    stub_status on;
    allow 127.0.0.1;
    deny all;
  }
  location / {
    proxy_set_header Host '${KIBANA_URL_WITHOUT_PROTOCOL}';
    proxy_pass '${KIBANA_URL}';
    proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    proxy_set_header Connection "keep-alive";
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Strict-Transport-Security;
    proxy_set_header X-Scheme \$scheme;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host \$host;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header Authorization "Basic ${BASE64}";
    proxy_set_header Accept-Encoding "gzip, deflate, br";
    proxy_http_version 1.1;
    client_max_body_size 20M;
    proxy_read_timeout 600;
    proxy_buffering off;
    proxy_send_timeout 300;
    send_timeout 300;
    proxy_connect_timeout 300;
    proxy_redirect off;
  }
}

server {
  listen 9200;
  server_name elasticsearch;
  location / {
    proxy_pass '${ES_URL}';
    proxy_connect_timeout 300;
    proxy_send_timeout 300;
    proxy_read_timeout 300;
    send_timeout 300;
  }
}
NGINX_EOF

systemctl restart nginx
sleep 2
systemctl is-active --quiet nginx

# Workshop bootstrap: talk to ES through local nginx; Elastic Serverless tab uses :8080
export ELASTICSEARCH_URL="http://127.0.0.1:9200"
export KIBANA_URL="http://127.0.0.1:8080"
export ELASTICSEARCH_API_KEY
export ELASTICSEARCH_VERIFY_CERTS=false

WORKSHOP_DIR="${WORKSHOP_DIR:-/opt/elastic-workflow-workshop}"
# Default fork includes Serverless fixes; override WORKSHOP_REPO in config.yml environment if needed
WORKSHOP_REPO="${WORKSHOP_REPO:-https://github.com/poulsbopete/elastic-workflow-workshop.git}"
WORKSHOP_BRANCH="${WORKSHOP_BRANCH:-main}"

if [ ! -d "$WORKSHOP_DIR/.git" ]; then
    mkdir -p "$(dirname "$WORKSHOP_DIR")"
    git clone --branch "${WORKSHOP_BRANCH}" "$WORKSHOP_REPO" "$WORKSHOP_DIR" || \
    git clone "$WORKSHOP_REPO" "$WORKSHOP_DIR"
else
    git -C "$WORKSHOP_DIR" fetch origin 2>/dev/null || true
    git -C "$WORKSHOP_DIR" checkout "${WORKSHOP_BRANCH}" 2>/dev/null || true
    git -C "$WORKSHOP_DIR" pull --ff-only origin "${WORKSHOP_BRANCH}" 2>/dev/null || \
    git -C "$WORKSHOP_DIR" pull --ff-only || true
fi

# pip on minimal images (es3-api-v2): required for startup-serverless.sh (--target install)
if ! python3 -m pip --version >/dev/null 2>&1; then
    echo "WARN: python3 -m pip missing; attempting install (requires root)..."
    if [ "$(id -u)" -eq 0 ]; then
        if command -v apt-get >/dev/null 2>&1; then
            apt-get update -qq && apt-get install -y -qq python3-pip && python3 -m pip --version
        elif command -v yum >/dev/null 2>&1; then
            yum install -y -q python3-pip && python3 -m pip --version
        fi
    fi
fi

export WORKSHOP_DIR
bash "${WORKSHOP_DIR}/instruqt/startup-serverless.sh"

# Default env for Terminal + challenge scripts (es3-api nginx proxy, same as AO track)
cat > /etc/profile.d/elastic-workshop-serverless.sh <<EOF
export ELASTICSEARCH_URL=http://127.0.0.1:9200
export KIBANA_URL=http://127.0.0.1:8080
export ELASTICSEARCH_API_KEY="${ELASTICSEARCH_API_KEY}"
EOF
chmod 600 /etc/profile.d/elastic-workshop-serverless.sh

echo "Track setup complete (Serverless Elasticsearch + workshop app)."
